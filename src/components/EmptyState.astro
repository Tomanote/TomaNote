---
// Icons
import Icon from "./icons/Icon.astro";
import logoNotes from "../assets/logo/none-bg__notes.png";
// Languages
import { getLang, useTranslations } from "../i18n/utils";
const lang = getLang();
const t = useTranslations(lang);
---

<div id="tn-empty-state" class="h-auto flex items-center justify-center -z-1 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
  <div class="text-center max-w-md mx-auto p-6">
    <div class="flex items-center justify-center">
      <img src={logoNotes.src} alt="logo-notes" title="Tomanote Notes" class="w-15 -ml-2.5" />
      <h1 class="text-3xl! ml-3! mt-2! text-(--tn-color-text) font-bold" data-i18n="app.title">Tomanote</h1>
      <h1 class="sr-only" data-i18n="app.slogan"></h1>
    </div>

    <hr />

    <p class="font-semibold mb-3! text-(--tn-color-text)! mt-2! text-3xl!" data-i18n="app.doodle-title"></p>
    <h2 class="text-(--tn-color-text)! mb-6 text-lg! inline-block w-75"><span data-i18n="app.doodle-subtitle"></span><Icon name="plus" className="p-1! rounded-lg! bg-(--tn-theme-contrast) scale-100 inline-block ml-2! text-(--tn-neutral-tertiary-color)" /></h2>
  </div>
</div>
