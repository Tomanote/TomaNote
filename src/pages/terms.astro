---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang();
const t = useTranslations(lang);

const title = t("seo.terms.title");
const description = t("seo.terms.description");
---

<Layout isInfoPage={true}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "name": "Home", "position": 1, "item": "https://tomanote.app"},
        {"@type": "ListItem", "name": "Terms", "position": 2}
      ]
    }
  </script>

  <article id="tn-content-terms" class="info-page-container" data-testid="info-page">
    <div class="info-card">
      <h1 class="info-page-title">{t("terms.main-title")}</h1>

      <div class="info-sections">
        <section>
          <div class="info-callout">
            <p class="info-body-text lead">{t("terms.intro")}</p>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("terms.second-title1")}
          </h2>
          <div class="info-callout info-callout--highlight">
            <p class="info-body-text">{t("terms.second-description1")}</p>
          </div>
          <div class="info-tip" style="margin-top: 1rem;">
            <svg class="info-tip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>{t("terms.tip-export")}</span>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("terms.second-title2")}
          </h2>
          <div class="info-callout" style="border-left-color: #f87171;">
            <p class="info-body-text">{t("terms.second-description2")}</p>
          </div>
          <div class="info-tip info-tip--warn" style="margin-top: 1rem;">
            <svg class="info-tip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span>{t("terms.security-note")}</span>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("terms.second-title3")}
          </h2>
          <div class="info-callout" style="border-left-color: #eab308;">
            <p class="info-body-text">{t("terms.second-description3")}</p>
          </div>
          <div class="info-tip-grid">
            <div class="info-tip info-tip--safe">
              <svg class="info-tip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
              <span>{t("terms.url-check")}</span>
            </div>
            <div class="info-tip info-tip--warn">
              <svg class="info-tip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{t("terms.url-wifi")}</span>
            </div>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("terms.license-title")}
          </h2>
          <div class="info-callout" style="border-left-color: #a78bfa;">
            <p class="info-body-text">
              {t("terms.license-description")}
              <a href="https://www.gnu.org/licenses/agpl-3.0.en.html" target="_blank" rel="noopener noreferrer" style="font-weight: 600; text-decoration: underline; text-underline-offset: 3px;">GNU Affero General Public License (AGPL) v3.0</a>.
            </p>
          </div>
          <div class="info-tip" style="margin-top: 1rem;">
            <svg class="info-tip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #a78bfa;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
            <span>{t("terms.license-open-source")}</span>
          </div>
        </section>

        <section class="info-section">
          <div class="info-callout info-callout--quote">
            <p class="info-body-text">{t("terms.license-agreement")}</p>
          </div>
        </section>
      </div>

      <div class="info-footer">
        <a href="/">
          <svg class="info-back-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t("terms.back")}
        </a>
      </div>
    </div>
  </article>
</Layout>
