---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang();
const t = useTranslations(lang);

const title = t("seo.privacy.title");
const description = t("seo.privacy.description");
---

<Layout isInfoPage={true}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "name": "Home", "position": 1, "item": "https://tomanote.app"},
        {"@type": "ListItem", "name": "Privacy", "position": 2}
      ]
    }
  </script>

  <article id="tn-content-privacy" class="info-page-container" data-testid="info-page">
    <div class="info-card">
      <h1 class="info-page-title">{t("privacy.main-title")}</h1>

      <p class="info-body-text lead" style="margin-bottom: 1.5rem;">{t("privacy.intro")}</p>

      <div class="info-sections">
        <section>
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("privacy.storage-title")}
          </h2>
          <p class="info-body-text">{t("privacy.storage-description")}</p>
          <ul class="info-list">
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20" style="color: #22c55e;">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("privacy.storage-item1")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20" style="color: #22c55e;">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("privacy.storage-item2")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20" style="color: #22c55e;">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("privacy.storage-item3")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20" style="color: #22c55e;">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("privacy.storage-item4")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20" style="color: #22c55e;">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("privacy.storage-item5")}</span>
            </li>
          </ul>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("privacy.no-account-title")}
          </h2>
          <div class="info-callout">
            <p class="info-body-text">{t("privacy.no-account-description")}</p>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("privacy.security-title")}
          </h2>
          <div class="info-callout info-callout--highlight">
            <p class="info-body-text">
              {t("privacy.security-description")}
              <strong>{t("privacy.security-recommendation")}</strong>
            </p>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("privacy.changes-title")}
          </h2>
          <p class="info-body-text">{t("privacy.changes-description")}</p>
        </section>
      </div>

      <div class="info-footer">
        <a href="/">
          <svg class="info-back-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t("privacy.back")}
        </a>
      </div>
    </div>
  </article>
</Layout>
