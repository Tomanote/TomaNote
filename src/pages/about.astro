---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang();
const t = useTranslations(lang);

const title = t("seo.about.title");
const description = t("seo.about.description");
---

<Layout isInfoPage={true}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "name": "Home", "position": 1, "item": "https://tomanote.app"},
        {"@type": "ListItem", "name": "About", "position": 2}
      ]
    }
  </script>

  <article id="tn-content-about" class="info-page-container" data-testid="info-page">
    <div class="info-card">
      <h1 class="info-page-title">{t("about.main-title")}</h1>

      <div class="info-sections">
        <section>
          <p class="info-body-text lead">{t("about.main-first-description")}</p>
          <div class="info-callout">
            <p class="info-body-text">{t("about.main-second-description")}</p>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("about.first-list")}
          </h2>
          <div class="info-grid">
            <div class="info-grid-item">
              <svg class="info-grid-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
              </svg>
              <span>{t("about.first-list-item1")}</span>
            </div>
            <div class="info-grid-item">
              <svg class="info-grid-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span>{t("about.first-list-item2")}</span>
            </div>
            <div class="info-grid-item">
              <svg class="info-grid-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6-4h12a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 4v-4m-8 4v-4"></path>
              </svg>
              <span>{t("about.first-list-item3")}</span>
            </div>
            <div class="info-grid-item">
              <svg class="info-grid-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              <span>{t("about.first-list-item4")}</span>
            </div>
          </div>
        </section>

        <section class="info-section">
          <div class="info-callout info-callout--quote">
            <p class="info-body-text">{t("about.intro-third-description")}</p>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("about.second-title")}
          </h2>
          <div class="info-callout info-callout--highlight">
            <p class="info-body-text">{t("about.second-first-description")}</p>
          </div>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("about.title-second-list")}
          </h2>
          <ul class="info-list">
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("about.title-second-list-item1")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("about.title-second-list-item2")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("about.title-second-list-item3")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("about.title-second-list-item4")}</span>
            </li>
            <li class="info-list-item">
              <svg class="info-check-icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{t("about.title-second-list-item5")}</span>
            </li>
          </ul>
        </section>

        <section class="info-section">
          <h2 class="info-section-title">
            <span class="info-section-dot"></span>
            {t("about.third-title")}
          </h2>
          <div class="info-callout info-callout--quote">
            <p class="info-body-text">{t("about.third-first-description")}</p>
          </div>
        </section>
      </div>

      <div class="info-footer">
        <a href="/">
          <svg class="info-back-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t("about.back")}
        </a>
      </div>
    </div>
  </article>
</Layout>
