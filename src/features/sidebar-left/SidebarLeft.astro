---
// src/features/sidebar-left/SidebarLeft.astro
// Left sidebar: logo, search (placeholder), settings (placeholder)

import "./sidebar-left.scss";
import Icon from "../../components/icons/Icon.astro";
import logoNotes from "../../assets/logo/none-bg__notes.png";
import { getLang, useTranslations } from "../../i18n/utils";

const t = useTranslations(getLang());
---

<aside class="sidebar-left hidden md:flex h-dvh!">
  <div class="sidebar-header">
    <img src={logoNotes.src} alt="tomanote-notes" title="Tomanote Notes" />
  </div>
  <div class="sidebar-body flex flex-col h-full justify-between">
    <div class="sidebar-left__top">
      <div class="group relative">
        <button tabindex="0" aria-label={t("context-menu.search")} class="sidebar-left__btn cursor-pointer!" onclick="window.commandPalette?.open()">
          <Icon name="search" className="text-(--tn-theme-contrast)" strokeWidth={3} />
        </button>
        <span data-i18n="context-menu.search" class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
          {t("context-menu.search")}
        </span>
      </div>
    </div>
    <div class="sidebar-left__bottom">
      <div class="group relative">
        <button tabindex="0" aria-label={t("sidebar.docs")} class="sidebar-left__btn cursor-pointer!" onclick="window.open('https://docs.tomanote.app/', '_blank')">
          <Icon name="docs" className="text-(--tn-theme-contrast)" strokeWidth={2} />
        </button>
        <span data-i18n="sidebar.docs" class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
          {t("sidebar.docs")}
        </span>
      </div>
      <div class="group relative">
        <button tabindex="0" aria-label={t("shortcuts.help")} class="sidebar-left__btn cursor-pointer!" onclick="window.keyboardShortcutsHelp?.toggle()">
          <Icon name="help" className="text-(--tn-theme-contrast)" strokeWidth={3} />
        </button>
        <span data-i18n="shortcuts.help" class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
          {t("shortcuts.help")}
        </span>
      </div>
      <div class="group relative">
        <button tabindex="0" aria-label={t("context-menu.settings")} class="sidebar-left__btn cursor-pointer!" onclick="event.preventDefault(); document.querySelector('dialog#info-notepad').showModal()">
          <Icon name="settings" className="text-(--tn-theme-contrast)" strokeWidth={3} />
        </button>
        <span data-i18n="context-menu.settings" class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
          {t("context-menu.settings")}
        </span>
      </div>
    </div>
  </div>
</aside>
