---
// src/features/keyboard-shortcuts-help/keyboard-shortcuts-help.astro
// Keyboard shortcuts help overlay modal

import "./keyboard-shortcuts-help.scss";
import Icon from "../../components/icons/Icon.astro";
import { getLang, useTranslations } from "../../i18n/utils";

const t = useTranslations(getLang());
---

<dialog id="keyboardShortcutsHelp" class="ks-help">
  <div class="ks-help__backdrop" data-action="close"></div>
  <div class="ks-help__container">
    <div class="ks-help__header">
      <h2 class="ks-help__title" data-i18n="shortcuts.title">{t("shortcuts.title")}</h2>
      <button class="ks-help__close" data-action="close" aria-label={t("shortcuts.close")}>
        <Icon name="close" className="ks-help__close-icon" strokeWidth={2} />
      </button>
    </div>
    <div id="ksHelpContent" class="ks-help__content">
      <!-- Populated by JS -->
    </div>
    <div class="ks-help__footer">
      <kbd class="ks-help__kbd">Alt+/</kbd>
      <span data-i18n="shortcuts.footer">{t("shortcuts.footer")}</span>
    </div>
  </div>
</dialog>
