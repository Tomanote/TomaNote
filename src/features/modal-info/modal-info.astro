---
// Styles
import "./modal-info.scss";

//Logo
import logoNotes from "../../assets/logo/none-bg__notes.png";

// Icons
import Icon from "../../components/icons/Icon.astro";

// i18n
import { getLang, useTranslations } from "../../i18n/utils";
const t = useTranslations(getLang());

// Components
import SettingsNavItem from "./components/SettingsNavItem.astro";

// Settings Tabs
import AboutTab from "./components/tabs/AboutTab.astro";
import LicenseTab from "./components/tabs/LicenseTab.astro";
import TermsTab from "./components/tabs/TermsTab.astro";
import FontTab from "./components/tabs/FontTab.astro";
import AppearanceTab from "./components/tabs/AppearanceTab.astro";
import RoadmapTab from "../roadmap/RoadmapTab.astro";

const navItems = [
  { tabId: "about", iconName: "about", labelKey: "mtb.about", className: "active" },
  { tabId: "license", iconName: "license", labelKey: "mtb.licence" },
  { tabId: "terms", iconName: "terms", labelKey: "mtb.terms" },
  { tabId: "roadmap", iconName: "roadmap", labelKey: "mtb.roadmap" },
  { tabId: "fonts", iconName: "tipo", labelKey: "mtb.typo" },
  { tabId: "appearance", iconName: "appearance", labelKey: "mtb.appearance" },
];
---

<section id="modals">
  <dialog
    id="info-notepad"
    class="settings-modal open:block open:opacity-100 open:scale-100 open:absolute open:top-1/2 open:left-1/2 open:-translate-1/2 sm:h-[90vh]! md:h-[80vh] lg:w-[70%] lg:max-w-[70%] h-auto md:min-h-[unset] w-[90%] max-w-[90vw] min-h-150 max-h-[70vh] sm:max-h-[90vh] text-(--color-text)! bg-(--tn-theme-primary-dark) overflow-hidden shadow-2xl rounded-2xl scale-100 opacity-0 hidden border-0 p-0!"
    role="dialog"
    aria-modal="true"
    aria-labelledby="settings-title"
    aria-describedby="settings-desc">
    <div class="settings-container lg:flex-row flex h-full flex-col">
      {/* Left Sidebar */}
      <div class="settings-sidebar lg:justify-between md:w-auto w-full bg-(--tn-theme-accent) flex flex-col min-h-auto pt-5! pb-3! px-4!">
        <div class="user-section border-b border-(--color-text) text-center pt-0! px-3! pb-1.5!">
          <h2 id="settings-title" class="flex items-center justify-start text-xl! font-semibold m-0! text-(--color-text)">
            <img src={logoNotes.src} alt="tomanote-notes" title="TomaNote Notes" class="w-10" />
            TomaNote
          </h2>
          <p id="settings-desc" class="sr-only">Settings and preferences for TomaNote app</p>
          <span class="version text-sm! text-(--color-text)">v 0.5.5</span>
        </div>

        <nav class="settings-nav bg-(--tn-neutral-tertiary-color)/10 rounded-lg mt-4! px-1.25!">
          {navItems.map((item) => <SettingsNavItem className={item.className || ""} tabId={item.tabId} iconName={item.iconName} labelKey={item.labelKey} />)}
        </nav>

        <div class="sidebar-footer">
          <div class="settings-external-links flex justify-center gap-4 mb-3!">
            <a href="https://blog.tomanote.app" target="_blank" rel="noopener noreferrer" class="settings-external-link group relative" aria-label={t("sidebar.blog")}>
              <Icon name="blog" className="size-5! text-(--color-text)" strokeWidth={2} />
              <span class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
                {t("sidebar.blog")}
              </span>
            </a>
            <a href="https://docs.tomanote.app" target="_blank" rel="noopener noreferrer" class="settings-external-link group relative" aria-label={t("sidebar.docs")}>
              <Icon name="docs" className="size-5! text-(--color-text)" strokeWidth={2} />
              <span class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
                {t("sidebar.docs")}
              </span>
            </a>
            <a href="https://github.com/Tomanote/TomaNote/issues/new?template=bug-report.md" target="_blank" rel="noopener noreferrer" class="settings-external-link group relative" aria-label={t("sidebar.bug")}>
              <Icon name="bug" className="size-5! text-(--color-text)" strokeWidth={2} />
              <span class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
                {t("sidebar.bug")}
              </span>
            </a>
            <a href="https://github.com/Tomanote/TomaNote/issues/new?template=feature-request.md" target="_blank" rel="noopener noreferrer" class="settings-external-link group relative" aria-label={t("sidebar.feature")}>
              <Icon name="lightbulb" className="size-5! text-(--color-text)" strokeWidth={2} />
              <span class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap rounded bg-(--tn-theme-primary) px-1! py-1/2! text-xs! text-(--tn-neutral-tertiary-color) opacity-0 transition-opacity group-hover:opacity-100 border border-(--tn-theme-contrast)! z-50">
                {t("sidebar.feature")}
              </span>
            </a>
          </div>
          <form enctype="application/x-www-form-urlencoded" method="dialog">
            <button class="save-button w-full p-3! border-0 rounded-sm bg-(--tn-theme-contrast) text-(--tn-neutral-tertiary-color)! cursor-pointer text-normal! transition-all hover:bg-(--tn-theme-contrast)/85! hover flex items-center justify-center gap-2">
              <Icon name="check" className="size-1 md:size-6" />
              <span data-i18n="mtb.submit"></span>
            </button>
          </form>
        </div>
      </div>

      {/* Main COntent */}
      <div class="settings-content flex-1 p-6! overflow-y-scroll bg-(--tn-theme-secondary)">
        {/* "About" Tab */}
        <AboutTab />

        {/* "Licence" Tab */}
        <LicenseTab />

        {/* "Terms" tab */}
        <TermsTab />

        {/* "Roadmap" Tab */}
        <RoadmapTab />

        {/* "Typography" Tab  */}
        <FontTab />

        {/* "Theme tab" */}
        <AppearanceTab />
      </div>
    </div>
  </dialog>
</section>
