{
  "name": "notepad-astro",
  "type": "module",
  "version": "0.5.6",
  "scripts": {
    "sync:roadmap": "node scripts/sync-roadmap-locales.cjs",
    "changelog": "node scripts/generate-changelog.cjs",
    "dev": "npm run sync:roadmap && astro dev",
    "build": "npm run sync:roadmap && npm run changelog && astro build",
    "predev": "npm run sync:roadmap",
    "prebuild": "npm run sync:roadmap && npm run changelog",
    "deploy": "gh-pages -d dist -t",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "postrelease": "node scripts/update-readme.js",
    "security:check": "npm audit --audit-level=high",
    "security:fix": "npm audit fix",
    "security:outdated": "npm outdated"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-tooltip": "^7.22.1",
    "@milkdown/theme-nord": "^7.22.1",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.1.0",
    "sass": "^1.86.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.0.16",
    "typescript": "^5.9.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/coverage-v8": "^4.1.10",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.4.0",
    "standard-version": "^9.5.0",
    "terser": "^5.44.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "ws": "^8.21.0",
    "brace-expansion": ">=2.1.2",
    "fast-uri": "^3.1.7"
  }
}
